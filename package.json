{
  "name": "voice-signaling-session-service",
  "version": "1.0.0",
  "description": "Discordia - Voice Signaling Session Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:coverage": "c8 --check-coverage --lines 85 --functions 85 --branches 85 --statements 85 --reporter=text --reporter=lcov tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^10.0.1",
    "amqplib": "^0.10.4",
    "fastify": "^4.29.1",
    "livekit-server-sdk": "^2.19.3",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "c8": "^10.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2"
  }
}
